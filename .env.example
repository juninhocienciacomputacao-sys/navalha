# Sem estas duas chaves o app roda com dados de demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dados da empresa que aparecem na Política de privacidade e nos Termos (/privacidade e /termos).
NEXT_PUBLIC_COMPANY_NAME=
# CNPJ (Brasil) ou número fiscal/VAT (Europa)
NEXT_PUBLIC_COMPANY_ID=
NEXT_PUBLIC_COMPANY_ADDRESS=
# e-mail do encarregado de dados (DPO), para pedidos de privacidade
NEXT_PUBLIC_PRIVACY_EMAIL=

# App na Google Play (opcional): pacote e impressão digital SHA-256 do certificado (Play Console → Integridade do app).
ANDROID_PACKAGE=
ANDROID_SHA256=
